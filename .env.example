# Server Configuration
PORT=5050
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI='mongodb://127.0.0.1:27017/my_db'
USE_IN_MEMORY_MONGO=false
AUTO_IN_MEMORY_FALLBACK=false
STRICT_DB=false

# JWT Configuration
JWT_SECRET='mero_sercret'

# CORS Configuration (Flutter web / mobile)
CLIENT_ORIGIN='http://localhost:3000'
ALLOWED_ORIGINS='http://localhost:3000,http://localhost:8080,http://localhost:5000'

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Flutter API Base URL (for Flutter app configuration)
FLUTTER_API_BASE_URL='http://10.0.2.2:5050/api/v1'

